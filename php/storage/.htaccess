# Ce dossier stocke les compteurs de rate limiting (fichiers JSON).
# Il ne doit JAMAIS être accessible directement depuis le web.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 (hébergeurs plus anciens)
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
